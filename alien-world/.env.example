# Copy this file to .env. Add any combination of provider keys.
# Keep .env private; never commit or share it.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides.
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Provider fallback order (only configured providers are used).
PROVIDER_ORDER=Gemini,Groq,NVIDIA,OpenRouter
